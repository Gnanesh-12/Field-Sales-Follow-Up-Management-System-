// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model Employee {
  id          String       @id @default(uuid())
  name        String
  password    String       // For basic auth, though plan says mock
  role        String       @default("employee-role")
  fieldVisits FieldVisit[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model CustomerSite {
  id          String       @id @default(uuid())
  name        String
  address     String
  fieldVisits FieldVisit[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model FieldVisit {
  id             String       @id @default(uuid())
  timestamp      DateTime     @default(now())
  notes          String?
  employeeId     String
  employee       Employee     @relation(fields: [employeeId], references: [id])
  customerSiteId String
  site           CustomerSite @relation(fields: [customerSiteId], references: [id])
  followUps      FollowUp[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

model FollowUp {
  id           String     @id @default(uuid())
  dueDate      DateTime
  status       String     @default("pending") // 'pending', 'completed'
  notes        String?
  fieldVisitId String
  visit        FieldVisit @relation(fields: [fieldVisitId], references: [id])
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
}
