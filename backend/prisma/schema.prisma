// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  
  url      = env("DATABASE_URL")
}

model Employee {
  id          String       @id // Employee ID like SE-FS-001
  name           String
  phone          String?
  profilePicture String?
  password       String       // For basic auth (PIN)
  role        String       @default("employee-role")
  status      String       @default("active") // 'active' | 'deactivated'
  fieldVisits FieldVisit[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model CustomerSite {
  id          String       @id @default(uuid())
  name        String
  address     String
  geoTag      String?
  fieldVisits FieldVisit[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model Material {
  id       String           @id @default(uuid())
  name     String
  unit     String           // e.g. 'kg', 'units', 'litres'
  supplies MaterialSupply[]
  createdAt DateTime        @default(now())
}

model FieldVisit {
  id             String           @id @default(uuid())
  timestamp      DateTime         @default(now())
  notes          String?
  remarks        String?
  employeeId     String
  employee       Employee         @relation(fields: [employeeId], references: [id])
  customerSiteId String
  site           CustomerSite     @relation(fields: [customerSiteId], references: [id])
  followUps      FollowUp[]
  location       Location?
  attachments    Attachment[]
  materials      MaterialSupply[]
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
}

model FollowUp {
  id           String     @id @default(uuid())
  dueDate      DateTime
  status       String     @default("pending") // 'pending', 'completed'
  notes        String?
  fieldVisitId String
  visit        FieldVisit @relation(fields: [fieldVisitId], references: [id])
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
}

model Location {
  id           String     @id @default(uuid())
  lat          Float
  lng          Float
  accuracy     Float?
  fieldVisitId String     @unique
  visit        FieldVisit @relation(fields: [fieldVisitId], references: [id])
}

model Attachment {
  id           String     @id @default(uuid())
  fileUrl      String
  type         String     @default("image") // 'image'
  fieldVisitId String
  visit        FieldVisit @relation(fields: [fieldVisitId], references: [id])
  createdAt    DateTime   @default(now())
}

model MaterialSupply {
  id           String     @id @default(uuid())
  quantity     Float
  materialId   String
  material     Material   @relation(fields: [materialId], references: [id])
  fieldVisitId String
  visit        FieldVisit @relation(fields: [fieldVisitId], references: [id])
}
