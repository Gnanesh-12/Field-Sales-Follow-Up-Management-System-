// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model Employee {
  id              String           @id @map("_id") // Employee ID like SE-FS-001
  name            String
  phone           String?
  profilePicture  String?
  password        String // For basic auth (PIN)
  isFirstLogin    Boolean          @default(true)
  role            String           @default("employee-role")
  status          String           @default("active") // 'active' | 'deactivated'
  fieldVisits     FieldVisit[]
  gmailConnection GmailConnection?
  emailLogs       EmailLog[]
  emailThreads    EmailThread[]
  emailMessages   EmailMessage[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
}

model Admin {
  id              String                @id @map("_id")
  name            String
  email           String                @unique
  password        String
  role            String                @default("admin")
  gmailConnection AdminGmailConnection?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
}

model CustomerSite {
  id           String        @id @default(uuid()) @map("_id")
  name         String
  address      String
  email        String? // Customer email address for email communication
  geoTag       String?
  fieldVisits  FieldVisit[]
  emailLogs    EmailLog[]
  emailThreads EmailThread[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

// ─── Email Integration (Phase 1) ─────────────────────────────────

model GmailConnection {
  id           String    @id @default(uuid()) @map("_id")
  employeeId   String    @unique
  employee     Employee  @relation(fields: [employeeId], references: [id])
  gmailAddress String // The connected Gmail address
  accessToken  String // Encrypted OAuth access token
  refreshToken String // Encrypted OAuth refresh token
  tokenExpiry  DateTime // When the access token expires
  scopes       String // Granted OAuth scopes
  isActive     Boolean   @default(true) // Whether connection is active
  connectedAt  DateTime  @default(now())
  historyId    String?
  lastSyncedAt DateTime?
  updatedAt    DateTime  @updatedAt
}

model AdminGmailConnection {
  id      String @id @default(uuid()) @map("_id")
  adminId String @unique
  admin   Admin  @relation(fields: [adminId], references: [id])

  gmailAddress String
  accessToken  String
  refreshToken String
  tokenExpiry  DateTime
  scopes       String

  isActive Boolean @default(true)

  connectedAt  DateTime  @default(now())
  historyId    String?
  lastSyncedAt DateTime?
  updatedAt    DateTime  @updatedAt
}

model EmailLog {
  id              String        @id @default(uuid()) @map("_id")
  employeeId      String
  employee        Employee      @relation(fields: [employeeId], references: [id])
  customerSiteId  String?
  customerSite    CustomerSite? @relation(fields: [customerSiteId], references: [id])
  fieldVisitId    String?
  senderEmail     String // The Gmail address used to send
  recipientEmail  String // To address
  ccEmails        String[] // CC addresses
  subject         String
  bodyPreview     String? // First ~200 chars of body for history display
  gmailMessageId  String? // Gmail API message ID
  status          String        @default("QUEUED") // QUEUED | SENT | FAILED
  errorMessage    String? // Error details if FAILED
  attachmentCount Int           @default(0)
  isVisitReport   Boolean       @default(false)
  sentAt          DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
}

model Material {
  id        String           @id @default(uuid()) @map("_id")
  name      String
  unit      String // e.g. 'kg', 'units', 'litres'
  supplies  MaterialSupply[]
  createdAt DateTime         @default(now())
}

model FieldVisit {
  id             String           @id @default(uuid()) @map("_id")
  timestamp      DateTime         @default(now())
  notes          String?
  remarks        String?
  status         String           @default("PENDING") // 'PENDING' | 'APPROVED' | 'DENIED'
  employeeId     String
  employee       Employee         @relation(fields: [employeeId], references: [id])
  customerSiteId String
  site           CustomerSite     @relation(fields: [customerSiteId], references: [id])
  followUps      FollowUp[]
  location       Location?
  attachments    Attachment[]
  materials      MaterialSupply[]
  // Approval metadata
  approvedBy     String? // Admin ID who approved
  approvedAt     DateTime? // When approved
  deniedBy       String? // Admin ID who denied
  deniedAt       DateTime? // When denied
  denialReason   String? // Reason provided for denial
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
}

model FollowUp {
  id           String     @id @default(uuid()) @map("_id")
  dueDate      DateTime
  status       String     @default("pending") // 'pending', 'completed'
  notes        String?
  fieldVisitId String
  visit        FieldVisit @relation(fields: [fieldVisitId], references: [id])
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
}

model Location {
  id           String     @id @default(uuid()) @map("_id")
  lat          Float
  lng          Float
  accuracy     Float?
  fieldVisitId String     @unique
  visit        FieldVisit @relation(fields: [fieldVisitId], references: [id])
}

model Attachment {
  id           String     @id @default(uuid()) @map("_id")
  fileUrl      String
  type         String     @default("image") // 'image'
  fieldVisitId String
  visit        FieldVisit @relation(fields: [fieldVisitId], references: [id])
  createdAt    DateTime   @default(now())
}

model MaterialSupply {
  id           String     @id @default(uuid()) @map("_id")
  quantity     Float
  materialId   String
  material     Material   @relation(fields: [materialId], references: [id])
  fieldVisitId String
  visit        FieldVisit @relation(fields: [fieldVisitId], references: [id])
}

model EmailThread {
  id             String    @id @default(uuid()) @map("_id")
  employeeId     String
  customerSiteId String?
  gmailThreadId  String
  subject        String?
  participants   String[]
  lastMessageAt  DateTime?
  unreadCount    Int       @default(0)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  employee     Employee       @relation(fields: [employeeId], references: [id])
  customerSite CustomerSite?  @relation(fields: [customerSiteId], references: [id])
  messages     EmailMessage[]

  @@unique([employeeId, gmailThreadId])
}

model EmailMessage {
  id             String @id @default(uuid()) @map("_id")
  threadId       String
  employeeId     String
  gmailMessageId String
  gmailThreadId  String

  direction String // INBOUND | OUTBOUND

  fromEmail String
  toEmails  String[]
  ccEmails  String[]

  subject  String?
  bodyText String?
  bodyHtml String?
  snippet  String?

  messageId  String?
  inReplyTo  String?
  references String?

  isRead Boolean  @default(false)
  sentAt DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  thread   EmailThread @relation(fields: [threadId], references: [id])
  employee Employee    @relation(fields: [employeeId], references: [id])

  @@unique([employeeId, gmailMessageId])
}
