DATABASE_URL="mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority"
JWT_SECRET="your_secure_jwt_secret"
PORT=3000

# Vercel Blob — required for image uploads in production.
# Generate at: https://vercel.com/dashboard -> Storage -> Blob -> your store -> Settings
# MUST be set in Render's environment variables for the backend service.
# NEVER commit the real token. NEVER expose via VITE_* or Flutter.
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_your_token_here"

# Legacy: only required if you still serve old local uploads. Safe to omit in Vercel Blob-only mode.
# STORAGE_PATH="/app/uploads"

# ─── Phase 1: Email Integration ────────────────────────────────────
# Google OAuth 2.0 — Required for Gmail connection
# Get from: Google Cloud Console -> APIs & Services -> Credentials -> OAuth 2.0 Client IDs
# NEVER commit actual secrets. Set in Render environment variables for production.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:3000/email/gmail/callback/web"

# Gmail API scope — Phase 1 only needs send permission
GMAIL_SCOPES="https://www.googleapis.com/auth/gmail.send"

# Email provider: "gmail" for production, "mailpit" for local development/testing
EMAIL_PROVIDER="gmail"


# App deep link scheme for OAuth mobile redirect
APP_DEEP_LINK_SCHEME="kshetra"

